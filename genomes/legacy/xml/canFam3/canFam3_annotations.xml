            <Resource name="Refseq Curated"
                      path="https://hgdownload.soe.ucsc.edu/goldenPath/canFam3/database/ncbiRefSeqCurated.txt.gz"
                      hyperlink="https://www.ncbi.nlm.nih.gov/refseq/refseq_select/"/>
            <Resource name="Refseq All"
                      path="https://hgdownload.soe.ucsc.edu/goldenPath/canFam3/database/ncbiRefSeq.txt.gz"
