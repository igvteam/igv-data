                      path="https://hgdownload.soe.ucsc.edu/gbdb/canFam3/ncbiRefSeq/ncbiRefSeqOther.bb"
                      description="NCBI RefSeq Other Annotations (not NM_*, NR_*, XM_*, XR_*, NP_* or YP_*)"
